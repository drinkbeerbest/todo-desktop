{
  "name": "liubai-desktop",
  "private": true,
  "version": "1.0.2",
  "description": "留白 · 给重要的事，一点空间",
  "author": "Liubai",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "electron .",
    "dist": "node node_modules/electron/install.js && node scripts/icon.mjs && npm run build && node scripts/package.mjs",
    "test": "node --test tests/model.test.mjs tests/storage.test.mjs",
    "test:desktop": "node tests/desktop.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "44.9.3",
    "electron-builder": "^26.0.12",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "build": {
    "appId": "studio.liubai.todo",
    "productName": "留白",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "Liubai-${version}-Windows.exe"
    }
  }
}
